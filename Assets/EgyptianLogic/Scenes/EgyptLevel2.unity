--- !u!114 &586807257
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 586807255}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69fc2775b2c54083aeac9441a9757c29, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleId: 2.6.3
  tracker: {fileID: 446806436}
  stageIndex: 5
  startStageOnFirstInteraction: 1
  submitButton: {fileID: 848731442}
  statusText: {fileID: 1524426103}
  resultLight: {fileID: 90864510}
  idleColor: {r: 0.35, g: 0.3, b: 0.2, a: 1}
  correctColor: {r: 0.2, g: 1, b: 0.3, a: 1}
  incorrectColor: {r: 1, g: 0.2, b: 0.15, a: 1}
  incorrectFlashSeconds: 1.5
  successSfx: {fileID: 0}
  failSfx: {fileID: 0}
  onSolved:
    m_PersistentCalls:
      m_Calls: []
  onIncorrect:
    m_PersistentCalls:
      m_Calls: []
  onInteraction:
    m_PersistentCalls:
      m_Calls: []
  board: {fileID: 951045520}
  spec: '# M = 1 resta: se invierte B y se suma 1 con el acarreo de entrada

    X0
    = B0 ^ M

    X1 = B1 ^ M

    X2 = B2 ^ M

    X3 = B3 ^ M

    c0 = M

    S0
    = A0 ^ X0 ^ c0

    c1 = A0 & X0 | c0 & (A0 ^ X0)

    S1 = A1 ^ X1 ^ c1

    c2
    = A1 & X1 | c1 & (A1 ^ X1)

    S2 = A2 ^ X2 ^ c2

    c3 = A2 & X2 | c2 &
    (A2 ^ X2)

    S3 = A3 ^ X3 ^ c3

    c4 = A3 & X3 | c3 & (A3 ^ X3)

    C4
    = c4

    EQ = !(S0 | S1 | S2 | S3)

    LT = !C4

    GT = C4 & !EQ

    #
    El comparador solo se revisa en modo resta

    dc GT = !M

    dc EQ = !M

    dc
    LT = !M

'
  allowedGates: 
  liveTestInputs: []
  instructions: "Sumador/Restador con comparador. M = 0 suma, M = 1 resta (A \u2212
    B en complemento a 2: B XOR M y Cin = M).\nCon M = 1:  EQ = el resultado es 0, 
    LT = no hubo acarreo final,  GT = hubo acarreo y no es igual."
  instructionsText: {fileID: 1098902355}
  progressText: {fileID: 1568816999}
