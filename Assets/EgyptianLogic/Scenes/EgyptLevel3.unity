  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5fa2e5b825824744ca2100f521bd04b7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tracker: {fileID: 471760757}
  puzzles:
  - {fileID: 2060731441}
  - {fileID: 531223032}
  - {fileID: 836069640}
  - {fileID: 1835793009}
  cableSockets:
  - {fileID: 1061093588}
  - {fileID: 1425005106}
  firstStage: 0
  startText: "\xBFQu\xE9 no es obvio? Sigue el cable que titila que sale del reloj."
  firstPieceText: "El reloj tiene dos cables rotos. Pon la pieza que cay\xF3 en cualquiera
    de los dos: cada cable despierta dos retos nuevos."
  twoOpenHeader: "Despertaron dos retos. Sigue el nuevo cable que titila o dir\xEDgete
    al muro que est\xE1 por la puerta, con la palanca en el suelo."
  oneOpenHeader: Te falta un reto por resolver antes de continuar.
  secondPieceText: "Cay\xF3 una nueva pieza. Ponla en el cable del reloj que sigue
    roto."
  endText: "Todos los mecanismos funcionan. La salida est\xE1 abierta."
  whereIs:
  - 
  - "Busca el caj\xF3n de cubos ensartados en un cilindro: es el registro de desplazamiento."
  - "Sigue el cable del reloj que brilla: te lleva al guardi\xE1n de estados."
  - "Busca el sem\xE1foro que espera ser dise\xF1ado."
  - 'Sigue el cable del reloj que brilla: te lleva a la contrarreloj binaria.'
